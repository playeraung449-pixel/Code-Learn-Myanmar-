rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Pillar 1: Global Safety Net (Default-Deny Catch-All)
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check for validateFirestoreConnection
    match /test/{document} {
      allow read: if true;
    }

    // -------------------------------------------------------------
    // global helper functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // In a zero-trust environment, we strictly require email verification for writes
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'playeraung449@gmail.com' ||
        request.auth.token.email == 'mobilekyaltagon148@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function isTeacher() {
      return isVerified() && (
        request.auth.token.email == 'playeraung449@gmail.com' ||
        request.auth.token.email == 'mobilekyaltagon148@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().role == 'teacher' || getUserData().role == 'admin'))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\:\\.\\@]+$');
    }

    // -------------------------------------------------------------
    // Standalone Validation Blueprints (Pillar 2: Anti-Update-Gap)
    // -------------------------------------------------------------

    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.role is string && (data.role == 'student' || data.role == 'teacher' || data.role == 'admin')
        && (data.bio == null || (data.bio is string && data.bio.size() <= 500))
        && (data.photo == null || (data.photo is string && data.photo.size() <= 100000)) // Fits base64 avatars
        && (data.preferredLanguage == null || (data.preferredLanguage is string && data.preferredLanguage.size() <= 10))
        && (data.themePreference == null || (data.themePreference is string && data.themePreference.size() <= 20))
        && data.xp is int && data.xp >= 0
        && data.level is int && data.level >= 1 && data.level <= 100
        && (data.isPremium == null || data.isPremium is bool)
        && (data.premiumPlan == null || (data.premiumPlan is string && data.premiumPlan.size() <= 50))
        && (data.premiumUntil == null || (data.premiumUntil is string && data.premiumUntil.size() <= 100))
        && (data.premiumActivatedAt == null || (data.premiumActivatedAt is string && data.premiumActivatedAt.size() <= 100))
        && (data.coins == null || data.coins is int)
        && (data.learningStreak == null || data.learningStreak is int)
        && (data.longestStreak == null || data.longestStreak is int)
        && (data.lastCheckInDate == null || (data.lastCheckInDate is string && data.lastCheckInDate.size() <= 20))
        && (data.checkInHistory == null || data.checkInHistory is list)
        && (data.completedCourses == null || data.completedCourses is list)
        && (data.completedLessons == null || data.completedLessons is list)
        && (data.completedProjects == null || data.completedProjects is list)
        && (data.completedQuizzes == null || data.completedQuizzes is list)
        && (data.monthlyStreak == null || data.monthlyStreak is int)
        && (data.yearlyStreak == null || data.yearlyStreak is int)
        && (data.hideNameFromLeaderboard == null || data.hideNameFromLeaderboard is bool)
        && (data.studyMinutesToday == null || data.studyMinutesToday is int)
        && (data.kiboQuestionsAskedToday == null || data.kiboQuestionsAskedToday is int)
        && (data.lastMissionsResetDate == null || (data.lastMissionsResetDate is string && data.lastMissionsResetDate.size() <= 20))
        && (data.dailyMissionsState == null || data.dailyMissionsState is map)
        && (data.weeklyChallengesState == null || data.weeklyChallengesState is map)
        && (data.monthlyChallengesState == null || data.monthlyChallengesState is map)
        && (data.activeFrame == null || (data.activeFrame is string && data.activeFrame.size() <= 100))
        && (data.unlockedFrames == null || data.unlockedFrames is list)
        && (data.activeEffect == null || (data.activeEffect is string && data.activeEffect.size() <= 100))
        && (data.activeSessions == null || data.activeSessions is list)
        && (data.securityLogs == null || data.securityLogs is list)
        && (data.accountStatus == null || (data.accountStatus is string && data.accountStatus.size() <= 20))
        && (data.suspensionReason == null || (data.suspensionReason is string && data.suspensionReason.size() <= 500))
        && (data.suspendedAt == null || (data.suspendedAt is string && data.suspendedAt.size() <= 100))
        && (data.failedLoginAttempts == null || data.failedLoginAttempts is int)
        && (data.lockoutUntil == null || (data.lockoutUntil is string && data.lockoutUntil.size() <= 100));
    }

    function isValidCourse(data) {
      return data.courseId is string && data.courseId.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.category is string && data.category.size() <= 50
        && data.difficulty is string && (data.difficulty == 'Beginner' || data.difficulty == 'Intermediate' || data.difficulty == 'Advanced')
        && data.published is bool;
    }

    // Prevents ID injection and size overflows
    function isValidLesson(data) {
      return data.lessonId is string && data.lessonId.size() <= 100
        && data.courseId is string && data.courseId.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.lessonNumber is int && data.lessonNumber >= 1;
    }

    function isValidQuiz(data) {
      return data.quizId is string && data.quizId.size() <= 100
        && data.lessonId is string && data.lessonId.size() <= 100
        && data.questions is list && data.questions.size() <= 50
        && data.correctAnswers is list && data.correctAnswers.size() <= 50
        && data.passingScore is int && data.passingScore >= 0;
    }

    function isValidProject(data) {
      return data.projectId is string && data.projectId.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.description is string && data.description.size() <= 5000
        && data.difficulty is string && (data.difficulty == 'Beginner' || data.difficulty == 'Intermediate' || data.difficulty == 'Advanced');
    }

    function isValidAssignment(data) {
      return data.assignmentId is string && data.assignmentId.size() <= 100
        && data.uid == request.auth.uid
        && data.submissionURL is string && data.submissionURL.size() <= 1000
        && (data.grade == null || (data.grade is string && data.grade.size() <= 10))
        && (data.feedback == null || (data.feedback is string && data.feedback.size() <= 2000));
    }

    function isValidProgress(data) {
      return data.uid == request.auth.uid
        && data.courseId is string && data.courseId.size() <= 100
        && data.completedLessons is list && data.completedLessons.size() <= 100
        && (data.completedLessons.size() == 0 || data.completedLessons[0] is string);
    }

    function isValidCertificate(data) {
      return data.certificateId is string && data.certificateId.size() <= 100
        && data.uid is string && data.uid.size() <= 128
        && data.courseId is string && data.courseId.size() <= 100
        && data.courseName is string && data.courseName.size() <= 150
        && data.issuedDate is string && data.issuedDate.size() <= 50;
    }

    function isValidBookmark(data) {
      return data.uid == request.auth.uid
        && (data.lessonId == null || (data.lessonId is string && data.lessonId.size() <= 100))
        && (data.projectId == null || (data.projectId is string && data.projectId.size() <= 100))
        && (data.articleId == null || (data.articleId is string && data.articleId.size() <= 100));
    }

    function isValidNotification(data) {
      return data.notificationId is string && data.notificationId.size() <= 100
        && data.uid == request.auth.uid
        && data.title is string && data.title.size() <= 150
        && data.message is string && data.message.size() <= 1000
        && data.isRead is bool;
    }

    function isValidForumPost(data) {
      return data.authorId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 3000
        && data.author is string && data.author.size() <= 100
        && (data.category == null || (data.category is string && data.category.size() <= 100));
    }

    function isValidCommunityComment(data) {
      return data.commentId is string && data.commentId.size() <= 100
        && data.postId is string && data.postId.size() <= 100
        && data.authorId == request.auth.uid
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 1000;
    }

    function isValidBlog(data) {
      return data.blogId is string && data.blogId.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.content is string && data.content.size() <= 100000;
    }

    function isValidAIChatHistory(data) {
      return data.chatId is string && data.chatId.size() <= 100
        && data.uid == request.auth.uid
        && data.prompt is string && data.prompt.size() <= 5000
        && data.response is string && data.response.size() <= 100000;
    }

    function isValidSetting(data) {
      return data.settingsId is string && data.settingsId.size() <= 100
        && (data.maintenanceMode == null || data.maintenanceMode is bool)
        && (data.announcement == null || (data.announcement is string && data.announcement.size() <= 500))
        && (data.kpayNumber == null || (data.kpayNumber is string && data.kpayNumber.size() <= 100))
        && (data.kpayName == null || (data.kpayName is string && data.kpayName.size() <= 100))
        && (data.waveNumber == null || (data.waveNumber is string && data.waveNumber.size() <= 100))
        && (data.waveName == null || (data.waveName is string && data.waveName.size() <= 100));
    }

    function isValidPaymentRequest(data) {
      return data.requestId is string && data.requestId.size() <= 100
        && data.uid == request.auth.uid
        && data.planId is string && (data.planId == 'monthly' || data.planId == 'six_months' || data.planId == 'lifetime')
        && data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected' || data.status == 'cancelled' || data.status == 'refunded')
        && (data.userEmail == null || (data.userEmail is string && data.userEmail.size() <= 100))
        && (data.userName == null || (data.userName is string && data.userName.size() <= 100))
        && (data.screenshot == null || (data.screenshot is string && data.screenshot.size() <= 1000000))
        && (data.transactionRef == null || (data.transactionRef is string && data.transactionRef.size() <= 100))
        && (data.notes == null || (data.notes is string && data.notes.size() <= 1000))
        && (data.submittedAt == null || (data.submittedAt is string && data.submittedAt.size() <= 100))
        && (data.reviewedAt == null || (data.reviewedAt is string && data.reviewedAt.size() <= 100));
    }

    function isValidRefundRequest(data) {
      return data.refundId is string && data.refundId.size() <= 100
        && data.requestId is string && data.requestId.size() <= 100
        && data.uid == request.auth.uid
        && data.status is string && (data.status == 'requested' || data.status == 'under_review' || data.status == 'approved' || data.status == 'rejected' || data.status == 'completed')
        && data.description is string && data.description.size() <= 2000;
    }

    function isValidPaymentDispute(data) {
      return data.disputeId is string && data.disputeId.size() <= 100
        && data.uid == request.auth.uid
        && data.category is string && data.category.size() <= 50
        && data.description is string && data.description.size() <= 2000
        && data.status is string && (data.status == 'open' || data.status == 'in_progress' || data.status == 'resolved' || data.status == 'closed');
    }

    function isValidPaymentAuditLog(data) {
      return data.logId is string && data.logId.size() <= 100
        && data.entityType is string && data.entityType.size() <= 50
        && data.entityId is string && data.entityId.size() <= 100
        && data.action is string && data.action.size() <= 100
        && data.timestamp is string && data.timestamp.size() <= 100;
    }

    function isValidAssessmentAttempt(data) {
      return data.id is string && data.id.size() <= 100
        && data.uid is string && data.uid.size() <= 128
        && data.userEmail is string && data.userEmail.size() <= 150
        && data.userName is string && data.userName.size() <= 150
        && data.assessmentId is string && data.assessmentId.size() <= 100
        && data.assessmentTitle is string && data.assessmentTitle.size() <= 200
        && data.assessmentType is string && (data.assessmentType == 'lesson_quiz' || data.assessmentType == 'module_assessment' || data.assessmentType == 'final_assessment')
        && data.courseId is string && data.courseId.size() <= 100
        && data.courseTitle is string && data.courseTitle.size() <= 200
        && data.score is int && data.score >= 0
        && data.totalQuestions is int && data.totalQuestions >= 1
        && data.passed is bool
        && data.passingScore is int && data.passingScore >= 0
        && data.timeSpentSeconds is int && data.timeSpentSeconds >= 0
        && data.timestamp is string && data.timestamp.size() <= 100;
    }

    function isValidAssessmentSettings(data) {
      return data.id is string && data.id.size() <= 100
        && data.passingScorePercent is int && data.passingScorePercent >= 0 && data.passingScorePercent <= 100
        && data.xpReward is int && data.xpReward >= 0;
    }

    function isValidAssessmentQuestion(data) {
      return data.id is string && data.id.size() <= 100
        && data.type is string && (data.type == 'mc' || data.type == 'ma' || data.type == 'tf' || data.type == 'fitb' || data.type == 'prediction' || data.type == 'find_error' || data.type == 'coding')
        && data.question is string && data.question.size() <= 5000
        && data.explanation is string && data.explanation.size() <= 5000;
    }

    function isValidPersonalNote(data) {
      return data.id is string && data.id.size() <= 100
        && data.uid == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 20000
        && data.category is string && data.category.size() <= 50
        && (data.associatedId == null || (data.associatedId is string && data.associatedId.size() <= 100))
        && (data.associatedTitle == null || (data.associatedTitle is string && data.associatedTitle.size() <= 200))
        && (data.isPinned == null || data.isPinned is bool)
        && (data.tags == null || data.tags is list)
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidSavedCodeSnippet(data) {
      return data.id is string && data.id.size() <= 100
        && data.uid == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && (data.description == null || (data.description is string && data.description.size() <= 1000))
        && data.code is string && data.code.size() <= 10000
        && data.language is string && data.language.size() <= 50
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidPortfolioProject(data) {
      return data.id is string && data.id.size() <= 100
        && data.uid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 10000
        && (data.projectType == null || (data.projectType is string && data.projectType.size() <= 50))
        && (data.difficulty == null || (data.difficulty is string && data.difficulty.size() <= 50))
        && (data.status == null || (data.status is string && data.status.size() <= 50))
        && (data.completionDate == null || (data.completionDate is string && data.completionDate.size() <= 50))
        && (data.languages == null || data.languages is list)
        && (data.frameworks == null || data.frameworks is list)
        && (data.screenshot == null || (data.screenshot is string && data.screenshot.size() <= 1000000))
        && (data.thumbnail == null || (data.thumbnail is string && data.thumbnail.size() <= 1000000))
        && (data.githubUrl == null || (data.githubUrl is string && data.githubUrl.size() <= 1000))
        && (data.liveDemoUrl == null || (data.liveDemoUrl is string && data.liveDemoUrl.size() <= 1000))
        && (data.visibility == null || (data.visibility is string && (data.visibility == 'Public' || data.visibility == 'Private')))
        && (data.studentName == null || (data.studentName is string && data.studentName.size() <= 100))
        && (data.studentEmail == null || (data.studentEmail is string && data.studentEmail.size() <= 100))
        && (data.studentPhoto == null || (data.studentPhoto is string && data.studentPhoto.size() <= 100000))
        && (data.isFeatured == null || data.isFeatured is bool)
        && (data.likes == null || data.likes is int)
        && (data.views == null || data.views is int)
        && (data.likedBy == null || data.likedBy is list)
        && (data.tags == null || data.tags is list)
        && (data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 100))
        && (data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // -------------------------------------------------------------
    // Collection matches & action enforcements
    // -------------------------------------------------------------

    // Collection 1: users
    match /users/{userId} {
      allow get: if isVerified() && (request.auth.uid == userId || isTeacher());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      
      // Creating a student profile requires verified auth, matching ID, starting as student, and valid payload shape
      allow create: if isVerified() && request.auth.uid == userId
                    && isValidUser(incoming())
                    && incoming().role == 'student'
                    && incoming().xp <= 500
                    && incoming().level == 1
                    && (incoming().isPremium == null || incoming().isPremium == false)
                    && (incoming().accountStatus == null || incoming().accountStatus == 'active');
                    
      // Updates are restricted to non-immutable fields, incremental value bounds, or by admins
      allow update: if isVerified() && (
        (request.auth.uid == userId 
          && isValidUser(incoming())
          && incoming().role == existing().role
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && (!incoming().diff(existing()).affectedKeys().hasAny([
            'role', 'uid', 'email', 'joinedAt', 
            'isPremium', 'premiumPlan', 'premiumUntil', 'premiumActivatedAt', 
            'premiumSince', 'premiumExpiresAt', 'membershipStatus', 'paymentStatus',
            'telegramVerified', 'telegramVerificationStatus', 'telegramApprovedAt', 'telegramInviteLink',
            'accountStatus', 'suspensionReason', 'suspendedAt', 
            'failedLoginAttempts', 'lockoutUntil'
          ]))
          && incoming().xp >= existing().xp
          && (incoming().xp - existing().xp) <= 300 // Max progression delta limit
          && incoming().level >= existing().level && (incoming().level - existing().level) <= 1
          && (incoming().coins == null || (incoming().coins - existing().coins <= 300))
        )
        || isAdmin()
      );
      
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Collection 2: courses
    match /courses/{courseId} {
      allow read: if true; // Courses can be browsed publicly
      allow create: if isTeacher() && isValidId(courseId) && isValidCourse(incoming());
      allow update: if isTeacher() && isValidId(courseId) && isValidCourse(incoming());
      allow delete: if isAdmin() && isValidId(courseId);
    }

    // Collection 3: lessons
    match /lessons/{lessonId} {
      allow read: if true; // Learning lessons can be browsed publicly
      allow create: if isTeacher() && isValidId(lessonId) && isValidLesson(incoming());
      allow update: if isTeacher() && isValidId(lessonId) && isValidLesson(incoming());
      allow delete: if isAdmin() && isValidId(lessonId);
    }

    // Collection 4: quizzes
    match /quizzes/{quizId} {
      allow read: if true; // Quizzes can be browsed publicly
      allow create: if isTeacher() && isValidId(quizId) && isValidQuiz(incoming());
      allow update: if isTeacher() && isValidId(quizId) && isValidQuiz(incoming());
      allow delete: if isAdmin() && isValidId(quizId);
    }

    // Collection 5: projects
    match /projects/{projectId} {
      allow read: if true; // Projects catalog can be browsed publicly
      allow create: if isTeacher() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isTeacher() && isValidId(projectId) && isValidProject(incoming());
      allow delete: if isAdmin() && isValidId(projectId);
    }

    // Collection 6: assignments
    match /assignments/{assignmentId} {
      allow get: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      
      allow create: if isVerified() && isValidId(assignmentId)
                    && isValidAssignment(incoming())
                    && incoming().uid == request.auth.uid
                    && incoming().grade == null
                    && incoming().feedback == null;
                    
      allow update: if isVerified() && isValidId(assignmentId) && (
        // Action 1: Student edits their submission URL before grading
        (resource.data.uid == request.auth.uid 
          && isValidAssignment(incoming())
          && (!incoming().diff(existing()).affectedKeys().hasAny(['uid', 'grade', 'feedback']))
          && resource.data.grade == null) // Cannot modify if already graded
        // Action 2: Teacher grades the submission
        || (isTeacher() && isValidAssignment(incoming()) && incoming().uid == existing().uid)
      );
      
      allow delete: if isTeacher() && isValidId(assignmentId);
    }

    // Collection 7: progress
    match /progress/{progressId} {
      allow get: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      
      allow create: if isVerified() && isValidId(progressId) && isValidProgress(incoming());
                    
      allow update: if isVerified() && isValidId(progressId) && (
        (resource.data.uid == request.auth.uid 
          && isValidProgress(incoming())
          && (!incoming().diff(existing()).affectedKeys().hasAny(['uid', 'courseId'])))
        || isTeacher()
      );
      
      allow delete: if isAdmin() && isValidId(progressId);
    }

    // Collection 8: bookmarks
    match /bookmarks/{bookmarkId} {
      allow get: if isVerified() && resource.data.uid == request.auth.uid;
      allow list: if isVerified() && resource.data.uid == request.auth.uid;
      
      allow create: if isVerified() && isValidId(bookmarkId) && isValidBookmark(incoming());
      allow update: if isVerified() && isValidId(bookmarkId) && resource.data.uid == request.auth.uid && isValidBookmark(incoming());
      allow delete: if isVerified() && isValidId(bookmarkId) && resource.data.uid == request.auth.uid;
    }

    // Collection 9: certificates
    match /certificates/{certificateId} {
      allow get: if true; // Publicly readable for verification page!
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      
      allow create: if isVerified() && (request.auth.uid == incoming().uid || isTeacher()) && isValidId(certificateId) && isValidCertificate(incoming());
      allow update: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher()) && isValidId(certificateId) && isValidCertificate(incoming());
      allow delete: if isAdmin() && isValidId(certificateId);
    }

    // Collection 10: notifications
    match /notifications/{notificationId} {
      allow get: if isVerified() && resource.data.uid == request.auth.uid;
      allow list: if isVerified() && resource.data.uid == request.auth.uid;
      
      allow create: if isVerified() && isValidId(notificationId) && isValidNotification(incoming());
      
      // Updates are strictly locked to toggling the isRead field only
      allow update: if isVerified() && isValidId(notificationId) && resource.data.uid == request.auth.uid
                    && isValidNotification(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
                    
      allow delete: if isVerified() && isValidId(notificationId) && resource.data.uid == request.auth.uid;
    }

    // Collection 11: forum_posts (Forum posts)
    match /forum_posts/{postId} {
      allow read: if true; // Publicly browsable
      
      allow create: if (incoming().authorId == 'system-seed' || (isVerified() && incoming().authorId == request.auth.uid))
                    && isValidForumPost(incoming());
                    
      allow update: if isVerified() && isValidId(postId) && (
        (resource.data.authorId == request.auth.uid && isValidForumPost(incoming()))
        // Action: Upvoting / replying updates specific nested arrays/fields
        || (incoming().diff(existing()).affectedKeys().hasAny(['likes', 'likedBy', 'replies']))
        || isTeacher()
      );
      
      allow delete: if isVerified() && isValidId(postId) && (resource.data.authorId == request.auth.uid || isTeacher());
    }

    // Collection 12: community_comments (Post responses)
    match /community_comments/{commentId} {
      allow read: if true;
      
      allow create: if isVerified() && isValidId(commentId) && isValidCommunityComment(incoming());
                    
      allow update: if isVerified() && isValidId(commentId) && (
        (resource.data.authorId == request.auth.uid && isValidCommunityComment(incoming()))
        || isTeacher()
      );
      
      allow delete: if isVerified() && isValidId(commentId) && (resource.data.authorId == request.auth.uid || isTeacher());
    }

    // Collection 13: blogs
    match /blogs/{blogId} {
      allow read: if true; // Publicly readable
      allow create: if isTeacher() && isValidId(blogId) && isValidBlog(incoming());
      allow update: if isTeacher() && isValidId(blogId) && isValidBlog(incoming());
      allow delete: if isAdmin() && isValidId(blogId);
    }

    // Collection 14: ai_chat_history
    match /ai_chat_history/{chatId} {
      allow get: if isVerified() && resource.data.uid == request.auth.uid;
      allow list: if isVerified() && resource.data.uid == request.auth.uid;
      
      allow create: if isVerified() && isValidId(chatId) && isValidAIChatHistory(incoming());
                    
      allow update: if isVerified() && isValidId(chatId) && resource.data.uid == request.auth.uid
                    && isValidAIChatHistory(incoming())
                    && (!incoming().diff(existing()).affectedKeys().hasAny(['uid']));
                    
      allow delete: if isVerified() && isValidId(chatId) && resource.data.uid == request.auth.uid;
    }

    // Collection 15: settings
    match /settings/{settingsId} {
      allow read: if true; // Public configuration settings
      allow write: if isAdmin() && isValidId(settingsId) && isValidSetting(incoming());
    }

    // Collection 16: payment_requests
    match /payment_requests/{requestId} {
      allow get: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      
      allow create: if isVerified() && isValidId(requestId) 
                    && isValidPaymentRequest(incoming())
                    && incoming().status == 'pending'
                    && incoming().uid == request.auth.uid
                    && incoming().activationDate == null
                    && incoming().expirationDate == null
                    && incoming().reviewedAt == null;
                    
      allow update: if isVerified() && isValidId(requestId) && (
        isTeacher() ||
        (resource.data.uid == request.auth.uid && existing().status == 'pending' && incoming().status == 'cancelled'
         && !incoming().diff(existing()).affectedKeys().hasAny(['amountMMK', 'planId', 'transactionId', 'paymentMethod', 'reviewedAt', 'activationDate', 'expirationDate']))
      );
      
      allow delete: if isAdmin() && isValidId(requestId);
    }

    // Collection 24: refund_requests
    match /refund_requests/{refundId} {
      allow get: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isVerified() && isValidId(refundId) && incoming().uid == request.auth.uid && isValidRefundRequest(incoming());
      allow update: if isTeacher() && isValidId(refundId);
      allow delete: if isAdmin() && isValidId(refundId);
    }

    // Collection 25: payment_disputes
    match /payment_disputes/{disputeId} {
      allow get: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isVerified() && isValidId(disputeId) && incoming().uid == request.auth.uid && isValidPaymentDispute(incoming());
      allow update: if isTeacher() && isValidId(disputeId);
      allow delete: if isAdmin() && isValidId(disputeId);
    }

    // Collection 26: payment_audit_logs
    match /payment_audit_logs/{logId} {
      allow get: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isVerified() && isValidId(logId) && isValidPaymentAuditLog(incoming());
      allow update: if false; // Immutable audit trail
      allow delete: if isAdmin() && isValidId(logId);
    }

    // Collection 37: financial_audit_logs
    match /financial_audit_logs/{logId} {
      allow get, list: if isTeacher();
      allow create: if isTeacher() && isValidId(logId);
      allow update: if false; // Immutable audit trail
      allow delete: if isAdmin() && isValidId(logId);
    }

    // Collection 38: membership_history
    match /membership_history/{historyId} {
      allow get: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isTeacher() && isValidId(historyId);
      allow update: if false; // Immutable audit trail
      allow delete: if isAdmin() && isValidId(historyId);
    }

    // Collection 39: premium_plans
    match /premium_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(planId);
    }

    // Collection 40: payment_accounts
    match /payment_accounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(accountId);
    }

    // Collection 17: assessment_attempts
    match /assessment_attempts/{attemptId} {
      allow get: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isVerified() && incoming().uid == request.auth.uid && isValidAssessmentAttempt(incoming());
      allow update: if isTeacher() && isValidAssessmentAttempt(incoming());
      allow delete: if isAdmin() && isValidId(attemptId);
    }

    // Collection 18: assessment_settings
    match /assessment_settings/{settingsId} {
      allow read: if true;
      allow write: if isTeacher() && isValidId(settingsId) && isValidAssessmentSettings(incoming());
    }

    // Collection 19: custom_questions
    match /custom_questions/{questionId} {
      allow read: if isVerified();
      allow write: if isTeacher() && isValidId(questionId) && isValidAssessmentQuestion(incoming());
    }

    // Collection 20: personal_notes
    match /personal_notes/{noteId} {
      allow read: if isVerified() && resource.data.uid == request.auth.uid;
      allow create: if isVerified() && isValidId(noteId) && incoming().uid == request.auth.uid && isValidPersonalNote(incoming());
      allow update: if isVerified() && isValidId(noteId) && resource.data.uid == request.auth.uid && incoming().uid == request.auth.uid && isValidPersonalNote(incoming());
      allow delete: if isVerified() && isValidId(noteId) && resource.data.uid == request.auth.uid;
    }

    // Collection 21: saved_snippets
    match /saved_snippets/{snippetId} {
      allow read: if isVerified() && resource.data.uid == request.auth.uid;
      allow create: if isVerified() && isValidId(snippetId) && incoming().uid == request.auth.uid && isValidSavedCodeSnippet(incoming());
      allow update: if isVerified() && isValidId(snippetId) && resource.data.uid == request.auth.uid && incoming().uid == request.auth.uid && isValidSavedCodeSnippet(incoming());
      allow delete: if isVerified() && isValidId(snippetId) && resource.data.uid == request.auth.uid;
    }

    // Collection 22: platform_stats
    match /platform_stats/{statId} {
      allow read: if isVerified();
      allow write: if isVerified() && isValidId(statId);
    }

    // Collection 23: portfolio_projects
    match /portfolio_projects/{projectId} {
      allow get: if resource.data.visibility == 'Public' || (isVerified() && (resource.data.uid == request.auth.uid || isTeacher()));
      allow list: if true;
      
      allow create: if isVerified() && isValidId(projectId) && incoming().uid == request.auth.uid && isValidPortfolioProject(incoming());
      
      allow update: if isVerified() && isValidId(projectId) && (
        (resource.data.uid == request.auth.uid && incoming().uid == request.auth.uid && isValidPortfolioProject(incoming()))
        || (isTeacher() && isValidPortfolioProject(incoming()))
        || (incoming().diff(existing()).affectedKeys().hasAny(['likes', 'views', 'likedBy']))
      );
      
      allow delete: if isVerified() && isValidId(projectId) && (resource.data.uid == request.auth.uid || isTeacher());
    }

    // Collection 27: announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isTeacher() && isValidId(announcementId);
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    // Collection 28: community_reports
    match /community_reports/{reportId} {
      allow get, list: if isTeacher();
      allow create: if isVerified() && isValidId(reportId);
      allow update, delete: if isTeacher() && isValidId(reportId);
    }

    // Collection 29: community_categories
    match /community_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(categoryId);
    }

    // Collection 30: moderation_audit_logs
    match /moderation_audit_logs/{logId} {
      allow read: if isTeacher();
      allow create: if isTeacher() && isValidId(logId);
      allow update: if false; // Append-only immutable audit trail
      allow delete: if isAdmin() && isValidId(logId);
    }

    // Collection 31: system_configs
    match /system_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(configId);
    }

    // Collection 32: kibo_knowledge_items
    match /kibo_knowledge_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(itemId);
    }

    // Collection 33: kibo_prompt_versions
    match /kibo_prompt_versions/{versionId} {
      allow read, write: if isAdmin() && isValidId(versionId);
    }

    // Collection 34: kibo_audit_logs
    match /kibo_audit_logs/{logId} {
      allow read, write: if isAdmin() && isValidId(logId);
    }

    // Collection 35: kibo_usage_metrics
    match /kibo_usage_metrics/{metricId} {
      allow read, write: if isTeacher() && isValidId(metricId);
    }

    // Collection 36: audit_logs
    match /audit_logs/{logId} {
      allow get, list: if isTeacher();
      allow create: if isVerified() && isValidId(logId);
      allow update: if false; // Append-only immutable audit trail
      allow delete: if isAdmin() && isValidId(logId);
    }

    // Collection 41: telegram_access_requests
    match /telegram_access_requests/{requestId} {
      allow get: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isVerified() && isValidId(requestId) 
                    && incoming().uid == request.auth.uid 
                    && incoming().status == 'pending'
                    && incoming().privateInviteLink == null;
      allow update: if isTeacher() && isValidId(requestId);
      allow delete: if isAdmin() && isValidId(requestId);
    }

    // Collection 42: system_settings
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }
  }
}

